<%- include('partials/header') %>
<%
  const couleur = t => t >= 60 ? "#FF6B3D" : t >= 35 ? "#FFB347" : t >= 15 ? "#C9C2E3" : "#6FA8FF";
  const lu = { oui: "pareil", mi: "en partie", non: "différent" }; // pour les lecteurs d'écran
%>

<div class="jour">
  <% if (!pret) { %>
    <h1>Le film du jour</h1>
    <p class="vide">Le film du jour se prépare… recharge dans quelques secondes.</p>
  <% } else { %>
    <div class="jour-titre">
      <h1>Le film du jour</h1>
      <span class="jour-label">n° <%= numero %> · <%= essais.length %> essai<%= essais.length > 1 ? "s" : "" %></span>
    </div>

        <% if (trouve) { %>
      <% const real = cible.credits.crew.find(p => p.job === "Director"); %>
      <section class="victoire">
        <% if (cible.poster_path) { %><img src="https://image.tmdb.org/t/p/w185<%= cible.poster_path %>" alt=""><% } %>
        <div>
          <span class="jour-label victoire-label">Trouvé · 100 °C</span>
          <h2><%= cible.title %></h2>
          <p><%= (cible.release_date || "").slice(0, 4) %><% if (real) { %> · <%= real.name %><% } %></p>
          <p><b><%= essais.length %> essai<%= essais.length > 1 ? "s" : "" %></b> · <%= nbIndices %> indice<%= nbIndices > 1 ? "s" : "" %></p>
          <a class="bouton secondaire" href="/films/<%= cible.id %>">Voir la fiche</a>
        </div>
      </section>

      <div class="carres" role="img" aria-label="Tes essais, du premier au dernier : <%= essais.slice().reverse().map(e => e.temp + ' degrés').join(', ') %>">
        <% essais.slice().reverse().forEach((e, i) => { %>
          <span style="--i: <%= i %>; background: <%= e.temp === 100 ? '#FFC94D' : couleur(e.temp) %>"></span>
        <% }) %>
      </div>

      <section>
        <h2 class="etiquette">Classement du jour</h2>
        <ol class="classement">
          <% classement.forEach((c, i) => { %>
            <li class="<%= c.username === user.username ? 'moi' : '' %>">
              <span class="rang"><%= i + 1 %></span>
              <img class="avatar-nav" src="/u/<%= encodeURIComponent(c.username) %>/avatar" alt="">
              <a href="/u/<%= encodeURIComponent(c.username) %>"><%= c.username %></a>
              <span class="score"><%= c.essais %> essai<%= c.essais > 1 ? "s" : "" %> · <%= c.indices %> indice<%= c.indices > 1 ? "s" : "" %></span>
            </li>
          <% }) %>
        </ol>
      </section>
    <% } else { %>
      <form class="jour-form" method="post" action="/jour/essai" autocomplete="off">
        <label class="sr-only" for="jour-champ">Propose un film</label>
        <input id="jour-champ" name="titre" placeholder="Propose un film…" required>
        <div class="jour-sugg" id="jour-sugg"></div>
      </form>

      <section class="indices">
        <h2 class="etiquette">Indices</h2>
        <div class="indices-grille">
          <% for (const ind of indices) { %>
            <% if (ind.valeur) { %>
              <div class="indice ouvert<%= ind.image ? ' image' : '' %><%= anime === 'indice-' + ind.n ? ' nouveau' : '' %>">>
                <small><%= ind.nom %></small>
                <% if (ind.image) { %>
                  <img src="https://image.tmdb.org/t/p/w185<%= ind.valeur %>" alt="Affiche floutée du film mystère">
                <% } else { %>
                  <b><%= ind.valeur %></b>
                <% } %>
              </div>
            <% } else if (ind.reste === 0) { %>
              <form method="post" action="/jour/indice/<%= ind.n %>">
                <button class="indice dispo"><small>Débloquer</small><b><%= ind.nom %></b></button>
              </form>
            <% } else { %>
              <div class="indice"><small><%= ind.nom %></small><span>dans <%= ind.reste %> essai<%= ind.reste > 1 ? "s" : "" %></span></div>
            <% } %>
          <% } %>
        </div>
      </section>
    <% } %>

    <div class="jour-legende" aria-hidden="true">
      <span><i class="case-oui"></i>Pareil</span>
      <span><i class="case-mi"></i>En partie</span>
      <span><i class="case-non"></i>Rien en commun</span>
      <span>↑ ↓ le film mystère est plus récent / plus ancien</span>
    </div>

    <ul class="essais">
      <% essais.forEach((e, n) => { %>
        <li class="<%= n === 0 && anime === 'essai' ? 'nouveau' : '' %>">>
          <div class="ligne"><b><%= e.titre %></b><b class="temp" style="color: <%= couleur(e.temp) %>"><%= e.temp %> °C</b></div>
          <div class="cases">
            <% e.cases.forEach((c, i) => { %>
              <div class="case case-<%= c.etat %>" style="--i: <%= i %>">
                <small><%= c.lab %></small><b><%= c.val %></b><span class="sr-only"><%= lu[c.etat] %></span>
              </div>
            <% }) %>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>

<% if (pret && !trouve) { %>
<script>
  const champ = document.getElementById("jour-champ");
  const boite = document.getElementById("jour-sugg");
  let derniere = 0;

  champ.addEventListener("input", async () => {
    const n = ++derniere;
    const q = champ.value.trim();
    if (q.length < 2) { boite.replaceChildren(); return; }
    const { films } = await (await fetch("/api/suggestions?q=" + encodeURIComponent(q))).json();
    if (n !== derniere) return;
    boite.replaceChildren(...films.map(f => {
      const b = document.createElement("button");
      b.name = "film_id";
      b.value = f.id;                 // c'est CE champ que le serveur reçoit
      const img = document.createElement("img");
      img.src = "https://image.tmdb.org/t/p/w92" + f.poster;
      img.alt = "";
      b.append(img, f.title + (f.year ? " (" + f.year + ")" : "")); // du texte, jamais du HTML
      return b;
    }));
  });
</script>
<% } %>

<%- include('partials/footer') %>