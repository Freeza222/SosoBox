<%- include("partials/header") %>

<h2><%= titre %> (<%= films.length %>)</h2>

<% if (films.length === 0) { %>
  <p>Aucun film pour l'instant.</p>
<% } %>

<ul class="resultats" style="list-style:none; padding:0">
  <% for (const f of films) { %>
    <li>
      <a href="/films/<%= f.id %>">
        <% if (f.poster_path) { %><img src="https://image.tmdb.org/t/p/w342<%= f.poster_path %>" alt=""><% } %>
        <%= f.title %> (<%= f.year %>)<% if (f.rating) { %> · <%= f.rating / 2 %>/5<% } %>
      </a>
    </li>
  <% } %>
</ul>

<%- include("partials/footer") %>