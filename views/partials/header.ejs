<!DOCTYPE html>
<html lang="fr">
  <head>
    <script src="/ciel.js" defer></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#2A1E4D">
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/style.css"/>
    <title>SosoBox</title>
    <meta name="description" content="SosoBox : note les films que tu as vus, tiens ton journal et suis ce que regardent tes amis.">
    <meta name="google-site-verification" content="NtBaB5EfaNFop_vUZeVat-2FLLEwYQGCTTHHITfryZY" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  </head>
  <body>
  <div class="ciel" aria-hidden="true">
  <div class="nebuleuse"><span></span><span></span><span></span></div>
  <div class="couche petite" data-nombre="350"></div>
  <div class="couche moyenne" data-nombre="120"></div>
  <div class="couche grande" data-nombre="40"></div>
  <span class="filante"></span><span class="filante"></span><span class="filante"></span>
  </div>
    <header class="barre">
        <% if (chemin !== "/") { %>
            <button type="button" class="retour" aria-label="Retour" onclick="retour()"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
        <% } %>
  <div class="barre-gauche"><a class="pilule <%= chemin === '/' ? 'actif' : '' %>" href="/">Accueil</a></div>

  <a class="logo" href="/"><img src="/logo-dark.svg" alt="" width="36" height="36"> SosoBox</a>

  <div class="barre-droite"><a class="pilule <%= chemin.startsWith('/search') ? 'actif' : '' %>" href="/search">Rechercher</a></div>

  <div class="compte">
    <% if (user) { %>
      <a class="cloche <%= chemin === '/notifications' ? 'actif' : '' %>" href="/notifications" title="Notifications" aria-label="Notifications<%= nbNotifs ? ' (' + nbNotifs + ' nouvelles)' : '' %>">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
        <% if (nbNotifs > 0) { %><span class="pastille"><%= nbNotifs > 9 ? "9+" : nbNotifs %></span><% } %>
      </a>
      <a href="/u/<%= encodeURIComponent(user.username) %>"><img class="avatar-nav" src="/u/<%= encodeURIComponent(user.username) %>/avatar" alt="Mon profil"></a>
      <a href="/u/<%= encodeURIComponent(user.username) %>"><%= user.username %></a>
    <% } else { %>
      <a href="/login">Connexion</a>
      <a href="/register">Inscription</a>
    <% } %>
  </div>
</header>

<nav class="dock" aria-label="Navigation principale">
  <a href="/" class="<%= chemin === '/' ? 'actif' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 11 12 3l9 8v10H3z"/></svg>Accueil
  </a>
  <a href="/search" class="<%= chemin.startsWith('/search') ? 'actif' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>Rechercher
  </a>
  <% if (user) { %>
    <a href="/u/<%= encodeURIComponent(user.username) %>/a-voir" class="<%= chemin.endsWith('/a-voir') ? 'actif' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg>Watchlist
    </a>
    <a href="/u/<%= encodeURIComponent(user.username) %>" class="<%= chemin === '/u/' + encodeURIComponent(user.username) ? 'actif' : '' %>">
      <img class="dock-avatar" src="/u/<%= encodeURIComponent(user.username) %>/avatar" alt="">Profil
    </a>
  <% } else { %>
    <a href="/login" class="<%= chemin === '/login' ? 'actif' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>Connexion
    </a>
  <% } %>
</nav>

<script>
  const pile = JSON.parse(sessionStorage.getItem("pile") || "[]");
  const ici = location.pathname + location.search;
  if (pile[pile.length - 2] === ici) pile.pop();          // retour natif du téléphone
  else if (pile[pile.length - 1] !== ici) pile.push(ici); // nouvelle page (pas un simple rechargement)
  if (pile.length > 50) pile.shift();
  sessionStorage.setItem("pile", JSON.stringify(pile));

  function retour() {
    pile.pop();
    sessionStorage.setItem("pile", JSON.stringify(pile));
    location.href = pile.length ? pile[pile.length - 1] : "/";
  }

  addEventListener("pageshow", e => { if (e.persisted) location.reload(); });
</script>