<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/style.css"/>
    <title>SosoBox</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  </head>
  <body>
    <header class="barre">
        <% if (chemin !== "/") { %>
            <button type="button" class="retour" aria-label="Retour" onclick="history.length > 1 ? history.back() : location.href = '/'">←</button>
        <% } %>
  <div class="barre-gauche"><a class="pilule" href="/">Accueil</a></div>

  <a class="logo" href="/"><img src="/logo-dark.svg" alt="" width="36" height="36"> SosoBox</a>

  <div class="barre-droite"><a class="pilule" href="/search">Rechercher</a></div>

  <div class="compte">
    <% if (user) { %>
      <a href="/u/<%= encodeURIComponent(user.username) %>"><img class="avatar-nav" src="/u/<%= encodeURIComponent(user.username) %>/avatar" alt="Mon profil"></a>
      <a href="/u/<%= encodeURIComponent(user.username) %>"><%= user.username %></a>
    <% } else { %>
      <a href="/login">Connexion</a>
      <a href="/register">Inscription</a>
    <% } %>
  </div>
</header>