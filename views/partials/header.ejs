<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/style.css"/>
    <title>SosoBox</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  </head>
  <body>
    <header class="barre">
  <a class="logo" href="/"><img src="/logo-dark.svg" alt="" width="36" height="36"> SosoBox</a>
  <nav>
    <a href="/">Accueil</a>
    <a href="/search">Rechercher</a>
  </nav>
  <div class="compte">
    <% if (user) { %>
      <a href="/u/<%= user.username %>"><img class="avatar-nav" src="/u/<%= user.username %>/avatar" alt="Mon profil"></a>
      <a href="/u/<%= encodeURIComponent(user.username) %>"><%= user.username %></a>
      <form method="post" action="/logout"><button>Déconnexion</button></form>
    <% } else { %>
      <a href="/login">Connexion</a>
      <a href="/register">Inscription</a>
    <% } %>
  </div>
</header>