
<%- include('partials/header') %>

    <% if (user) { %>
        <h2>Avis de tes abonnements</h2>
    <% if (fil.length === 0) { %>
        <p>Rien pour l'instant : suis des gens depuis leur profil.</p>
    <% } %>
    <ul class="fil">
  <% for (const a of fil) { %>
    <li>
      <div class="entete">
            <a href="/films/<%= a.film_id %>">
            <% if (a.poster_path) { %>
                <img src="https://image.tmdb.org/t/p/w342<%= a.poster_path %>" alt="">
            <% } %>
            </a>
            <div>
            <a href="/u/<%= encodeURIComponent(a.username) %>"><%= a.username %></a>
            a noté <a href="/films/<%= a.film_id %>"><%= a.title %></a> : <%= a.rating / 2 %>/5
            </div>
        </div>
      <% if (a.body) { %><p><%= a.body %></p><% } %>
    </li>
        <% } %>
    </ul>
    <% } %>
    <% for (const r of rangees) { %>
    <h2><%= r.titre %></h2>
        <div class="rangee">
            <% for (const f of r.films) { %>
                <a href="/films/<%= f.id %>" title="<%= f.title %>">
                    <% if (f.poster_path) { %>
                        <img src="https://image.tmdb.org/t/p/w185<%= f.poster_path %>" alt="<%= f.title %>" loading="lazy">
                    <% } %>
                </a>
            <% } %>
        </div>
    <% } %>

<%- include('partials/footer') %>
