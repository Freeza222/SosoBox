<%- include('partials/header') %>

<section class="hero-bandes">
  <div class="bande-cadre" aria-hidden="true">
    <div class="bande vers-gauche">
      <% for (const p of [...bandeHaut, ...bandeHaut]) { %><img src="https://image.tmdb.org/t/p/w185<%= p %>" alt=""><% } %>
    </div>
  </div>

  <div class="hero-contenu">
    <h1 class="logo-geant">SosoBox</h1>
    <form class="recherche" action="/search" role="search">
      <input name="q" placeholder="Un film, un ami…" aria-label="Rechercher">
      <button>Chercher</button>
    </form>
  </div>

  <div class="bande-cadre" aria-hidden="true">
    <div class="bande vers-droite">
      <% for (const p of [...bandeBas, ...bandeBas]) { %><img src="https://image.tmdb.org/t/p/w185<%= p %>" alt=""><% } %>
    </div>
  </div>
</section>
<div class="<%= user ? 'accueil' : '' %>">
  <% if (user) { %>
    <aside class="accueil-fil">
      <h2>Avis de tes abonnements</h2>
      <% if (fil.length === 0) { %>
        <p>Rien pour l'instant : suis des gens depuis leur profil.</p>
      <% } %>
      <ul class="fil">
        <% for (const a of fil) { %>
                    <li class="avis">
            <a class="avis-affiche" href="/films/<%= a.film_id %>">
              <% if (a.poster_path) { %>
                <img src="https://image.tmdb.org/t/p/w185<%= a.poster_path %>" alt="">
              <% } %>
            </a>
            <div class="avis-texte">
              <a href="/films/<%= a.film_id %>"><%= a.title %></a>
              <div class="etoiles" role="img" aria-label="<%= a.rating / 2 %> sur 5">
                <%= "★".repeat(Math.floor(a.rating / 2)) + (a.rating % 2 ? "½" : "") %>
              </div>
              <% if (a.body) { %><p class="avis-critique"><%= a.body %></p><% } %>
              <div class="avis-par">par <a href="/u/<%= encodeURIComponent(a.username) %>"><%= a.username %></a></div>
            </div>
          </li>
        <% } %>
      </ul>
    </aside>
  <% } %>

  <section class="accueil-rangees">
    <% for (const r of rangees) { %>
      <section class="verre">
        <h2><%= r.titre %></h2>
        <div class="rangee">
          <% for (const f of r.films) { %>
            <a href="/films/<%= f.id %>" title="<%= f.title %>">
              <% if (f.poster_path) { %>
                <img src="https://image.tmdb.org/t/p/w185<%= f.poster_path %>" alt="<%= f.title %>" loading="lazy">
              <% } %>
            </a>
          <% } %>
        </div>
      </section>
    <% } %>
  </section>
</div>

<script src="/glisser.js"></script>
<%- include('partials/footer') %>