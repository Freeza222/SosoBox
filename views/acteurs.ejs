<%- include('partials/header') %>

<div class="etroit page-acteurs">
  <h1>Mes acteurs préférés</h1>

  <h2 class="etiquette">Mon choix · <%= mes.length %>/3</h2>
  <% if (mes.length === 0) { %><p class="vide">Aucun pour l'instant : cherche un acteur ci-dessous.</p><% } %>
  <ul class="acteurs-liste">
    <% for (const a of mes) { %>
      <li>
        <img src="<%= a.photo ? 'https://image.tmdb.org/t/p/w185' + a.photo : '/avatar-defaut.svg' %>" alt="">
        <b><%= a.nom %></b>
        <form method="post" action="/acteurs/<%= a.person_id %>">
          <input type="hidden" name="q" value="<%= q %>">
          <button class="secondaire petit-btn">Retirer</button>
        </form>
      </li>
    <% } %>
  </ul>

  <form class="recherche" action="/acteurs" role="search" autocomplete="off">
    <div id="sugg-acteurs" class="sugg-acteurs" aria-live="polite"></div>
    <input name="q" value="<%= q %>" placeholder="Un acteur, une actrice…" aria-label="Chercher un acteur">
    <button>Chercher</button>
  </form>

  <% if (q && resultats.length === 0) { %><p class="vide">Personne trouvé pour « <%= q %> ».</p><% } %>
  <ul class="choix-acteurs">
    <% for (const p of resultats) { %>
      <li>
        <img src="<%= p.profile_path ? 'https://image.tmdb.org/t/p/w185' + p.profile_path : '/avatar-defaut.svg' %>" alt="" loading="lazy">
        <b><%= p.name %></b>
        <% if (choisis.has(p.id)) { %>
          <span class="deja">Déjà choisi</span>
        <% } else if (mes.length < 3) { %>
          <form method="post" action="/acteurs/<%= p.id %>">
            <input type="hidden" name="q" value="<%= q %>">
            <button class="petit-btn">Ajouter</button>
          </form>
        <% } %>
      </li>
    <% } %>
  </ul>
</div>

<% if (mes.length < 3) { %>
<script>
  const champ = document.querySelector('.page-acteurs input[name="q"]');
  const boite = document.getElementById("sugg-acteurs");
  const deja = new Set(<%- JSON.stringify([...choisis]) %>); // ids déjà choisis : ne pas les reproposer
  let derniere = 0;

  // un petit rond cliquable : il envoie le formulaire de recherche en POST vers /acteurs/<id>
  // (pas de <form> imbriqué : un formulaire dans un formulaire est interdit en HTML)
  function rond(a) {
    const bouton = document.createElement("button");
    bouton.className = "sugg-acteur";
    bouton.formAction = "/acteurs/" + a.id;
    bouton.formMethod = "post";
    const img = document.createElement("img");
    img.src = a.photo ? "https://image.tmdb.org/t/p/w185" + a.photo : "/avatar-defaut.svg";
    img.alt = "";
    const nom = document.createElement("span");
    nom.textContent = a.nom; // du texte, jamais du HTML
    bouton.append(img, nom);
    return bouton;
  }

  champ.addEventListener("input", async () => {
    const n = ++derniere;
    const q = champ.value.trim();
    if (q.length < 2) { boite.replaceChildren(); return; }
    const acteurs = await (await fetch("/api/acteurs?q=" + encodeURIComponent(q))).json();
    if (n !== derniere) return; // une frappe plus récente a déjà relancé la recherche
    boite.replaceChildren(...acteurs.filter(a => !deja.has(a.id)).map(rond));
  });
</script>
<% } %>

<script>
  // Sur cette page, chercher ou choisir un acteur REMPLACE la page dans l'historique
  document.addEventListener("submit", async e => {
    const f = e.target, b = e.submitter;
    const url = b?.getAttribute("formaction") || f.action;
    if (!new URL(url, location).pathname.startsWith("/acteurs")) return; // les autres formulaires (barre du haut…) restent normaux
    const methode = (b?.getAttribute("formmethod") || f.method).toLowerCase();
    const donnees = new URLSearchParams(new FormData(f, b));
    e.preventDefault();
    if (methode === "get") return location.replace(url.split("?")[0] + "?" + donnees);
    const r = await fetch(url, { method: "POST", body: donnees }); // le serveur répond par une redirection…
    location.replace(r.url);                                        // …on va à la page finale sans empiler
  });
</script>

<%- include('partials/footer') %>