<%- include('partials/header') %>

<div class="banniere" <% if (banniere) { %>style="background-image: url('https://image.tmdb.org/t/p/w1280<%= banniere %>')"<% } %>></div>

<div class="profil-entete">
  <img class="avatar-grand" src="/u/<%= encodeURIComponent(profil.username) %>/avatar" alt="">
  <div class="profil-nom">
    <h2><%= profil.username %></h2>
    <% if (profil.bio) { %><p><%= profil.bio %></p><% } %>
  </div>
  <div class="chiffres">
    <a href="/u/<%= encodeURIComponent(profil.username) %>/films"><b><%= total %></b>films</a>
    <a href="/u/<%= encodeURIComponent(profil.username) %>/abonnes"><b><%= abonnes %></b>abonnés</a>
    <a href="/u/<%= encodeURIComponent(profil.username) %>/abonnements"><b><%= abonnements %></b>abonnements</a>
  </div>
</div>

<p style="display: flex; flex-wrap: wrap; gap: .5rem">
  <a class="pilule" href="/u/<%= encodeURIComponent(profil.username) %>/a-voir">Watchlist</a>
  <a class="pilule" href="/u/<%= encodeURIComponent(profil.username) %>/stats">Statistiques</a>
</p>

<% if (user && user.id === profil.id) { %>
  <form method="post" action="/avatar" enctype="multipart/form-data">
    <label class="bouton">
      Changer ma photo
      <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp" hidden onchange="this.form.submit()">
    </label>
  </form>
<% } else if (user) { %>
  <form method="post" action="/u/<%= encodeURIComponent(profil.username) %>/follow">
    <button><%= suit ? "Ne plus suivre" : "Suivre" %></button>
  </form>
<% } %>

<h3>Films préférés</h3>
<ul class="favoris">
  <% for (let i = 0; i < 4; i++) { const f = favoris[i]; %>
    <li <% if (f && user && user.id === profil.id) { %>data-film="<%= f.id %>"<% } %>>
      <% if (f) { %>
        <a href="/films/<%= f.id %>"><img src="https://image.tmdb.org/t/p/w342<%= f.poster_path %>" alt="<%= f.title %>"></a>
        <% if (user && user.id === profil.id) { %>
          <form method="post" action="/films/<%= f.id %>/favori">
            <input type="hidden" name="retour" value="profil">
            <button class="retirer" aria-label="Retirer <%= f.title %> des favoris">×</button>
          </form>
        <% } %>
      <% } else if (user && user.id === profil.id && i === favoris.length) { %>
        <a class="case-vide" href="/search?fav=1">+</a>
      <% } else { %>
        <span class="case-vide"></span>
      <% } %>
    </li>
  <% } %>
</ul>

<h3>Derniers films vus</h3>
<% if (avis.length === 0) { %><p>Aucun film noté pour l'instant.</p><% } %>

<ul class="resultats">
  <% for (const f of avis) { %>
    <li>
      <a href="/films/<%= f.id %>">
        <% if (f.poster_path) { %>
          <img src="https://image.tmdb.org/t/p/w342<%= f.poster_path %>" alt="">
        <% } %>
        <span><%= f.title %> (<%= f.year || "" %>) · <%= f.rating / 2 %>/5</span>
      </a>
    </li>
  <% } %>
</ul>

<% if (user && user.id === profil.id) { %>
  <form method="post" action="/logout" style="margin-top: 2rem">
    <button class="secondaire">Déconnexion</button>
  </form>

   <script>
    const cases = [...document.querySelectorAll(".favoris li[data-film]")];
    let source = null, cible = null, bouge = false, x0 = 0, y0 = 0;

    function finir() {
      cases.forEach(c => c.classList.remove("glisse", "cible"));
      source = null;
    }

    cases.forEach(li => {
      li.addEventListener("pointerdown", e => {
        if (e.target.closest(".retirer")) return; // laisse marcher le bouton ×
        source = li; cible = null; bouge = false;
        x0 = e.clientX; y0 = e.clientY;
        li.setPointerCapture(e.pointerId);
      });

      li.addEventListener("pointermove", e => {
        if (source !== li) return;
        if (!bouge && Math.hypot(e.clientX - x0, e.clientY - y0) < 8) return; // simple clic
        bouge = true;
        li.classList.add("glisse");
        const dessous = document.elementFromPoint(e.clientX, e.clientY);
        cible = dessous && dessous.closest(".favoris li[data-film]");
        cases.forEach(c => c.classList.toggle("cible", c === cible && c !== li));
      });

      li.addEventListener("pointerup", async () => {
        if (source !== li) return;
        const a = li, b = cible;
        finir();
        if (bouge && b && b !== a) {
          await fetch("/favoris/echanger", {
            method: "POST",
            body: new URLSearchParams({ a: a.dataset.film, b: b.dataset.film }),
          });
          location.reload();
        }
      });

      li.addEventListener("pointercancel", finir);
      li.addEventListener("dragstart", e => e.preventDefault()); // coupe le glisser natif de l'image
      li.addEventListener("click", e => { if (bouge) e.preventDefault(); }, true); // pas d'ouverture du film après un glisser
    });
  </script>
<% } %>

<%- include('partials/footer') %>