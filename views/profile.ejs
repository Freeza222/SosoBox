<%- include('partials/header') %>

<div class="etroit">
<div class="banniere" <% if (banniere) { %>style="background-image: url('https://image.tmdb.org/t/p/w1280<%= banniere %>')"<% } %>></div>

<div class="profil-entete">
  <img class="avatar-grand" src="/u/<%= encodeURIComponent(profil.username) %>/avatar" alt="">
  <div class="profil-nom">
    <h2><%= profil.username %></h2>
    <% if (profil.bio) { %><p><%= profil.bio %></p><% } %>
  </div>
  <div class="chiffres">
    <a href="/u/<%= encodeURIComponent(profil.username) %>/films"><b><%= total %></b>films</a>
    <a href="/u/<%= encodeURIComponent(profil.username) %>/abonnes"><b><%= abonnes %></b>abonnés</a>
    <a href="/u/<%= encodeURIComponent(profil.username) %>/abonnements"><b><%= abonnements %></b>abonnements</a>
  </div>
</div>

<% if (user && user.id === profil.id) { %>
  <div style="display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.5rem">
    <form method="post" action="/avatar" enctype="multipart/form-data">
      <label class="bouton">
        Changer ma photo
        <input type="file" id="champ-photo" accept="image/jpeg,image/png,image/webp" hidden>
      </label>
    </form>
    <button type="button" class="secondaire" onclick="document.getElementById('pseudo').showModal()">Modifier mon profil</button>
  </div>

  <dialog id="pseudo">
    <form method="post" action="/pseudo">
      <h3>Modifier mon profil</h3>
      <label>Nouveau pseudo <input name="username" value="<%= profil.username %>" required minlength="3" maxlength="20"></label>
      <label>Bio <textarea name="bio" rows="3" maxlength="160" placeholder="Fan de SF et de Nolan"><%= profil.bio || "" %></textarea></label>
      <div class="actions">
        <button type="button" class="secondaire" onclick="this.closest('dialog').close()">Annuler</button>
        <button>Enregistrer</button>
      </div>
    </form>
  </dialog>
<% } else if (user) { %>
  <form method="post" action="/u/<%= encodeURIComponent(profil.username) %>/follow" style="margin-bottom: 1.5rem">
    <button><%= suit ? "Ne plus suivre" : "Suivre" %></button>
  </form>
<% } %>

<div class="profil-grille">
    <div class="profil-gauche">
    <section>
      <h2 class="etiquette">Top 4</h2>
      <ul class="favoris">
        <% for (let i = 0; i < 4; i++) { const f = favoris[i]; %>
          <li <% if (f && user && user.id === profil.id) { %>data-film="<%= f.id %>"<% } %>>
            <% if (f) { %>
              <a href="/films/<%= f.id %>"><img src="https://image.tmdb.org/t/p/w342<%= f.poster_path %>" alt="<%= f.title %>"></a>
              <% if (user && user.id === profil.id) { %>
                <a class="changer" href="/favoris/<%= f.id %>/affiche" aria-label="Changer l'affiche de <%= f.title %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="M21 15l-5-5L5 21"/></svg></a>
                <form method="post" action="/films/<%= f.id %>/favori">
                  <input type="hidden" name="retour" value="profil">
                  <button class="retirer" aria-label="Retirer <%= f.title %> des favoris">×</button>
                </form>
              <% } %>
            <% } else if (user && user.id === profil.id && i === favoris.length) { %>
              <a class="case-vide" href="/search?fav=1">+</a>
            <% } else { %>
              <span class="case-vide"></span>
            <% } %>
          </li>
        <% } %>
      </ul>
    </section>

    <nav class="profil-liens" aria-label="Pages du profil">
      <a href="/u/<%= encodeURIComponent(profil.username) %>/a-voir">
        <span class="lien-icone"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg></span>
        <span class="lien-texte">Watchlist<small>Les films à voir</small></span>
        <span class="lien-fin">›</span>
      </a>
      <a href="/u/<%= encodeURIComponent(profil.username) %>/films">
        <span class="lien-icone"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4"/></svg></span>
        <span class="lien-texte">Tous mes films<small><%= total %> films vus</small></span>
        <span class="lien-fin">›</span>
      </a>
      <a href="/u/<%= encodeURIComponent(profil.username) %>/stats">
        <span class="lien-icone"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg></span>
        <span class="lien-texte">Statistiques<small>Tes chiffres</small></span>
        <span class="lien-fin">›</span>
      </a>
    </nav>
  </div>

  <section class="profil-journal">
    <h2 class="etiquette">Journal</h2>
    <% if (journal.length === 0) { %>
      <p>Rien pour l'instant. Remplis la date « Vu le » quand tu notes un film pour remplir le journal.</p>
    <% } %>
    <ol class="journal">
      <% let moisPrecedent = ""; %>
      <% for (const j of journal) { %>
        <% const date = new Date(j.watched_on + "T12:00:00"); %>
        <% const mois = date.toLocaleDateString("fr-FR", { month: "long", year: "numeric" }); %>
        <% if (mois !== moisPrecedent) { moisPrecedent = mois; %>
          <li class="journal-mois"><%= mois %></li>
        <% } %>
        <li class="journal-ligne">
          <span class="journal-jour"><%= String(date.getDate()).padStart(2, "0") %></span>
          <a href="/films/<%= j.id %>">
            <% if (j.poster_path) { %><img src="https://image.tmdb.org/t/p/w92<%= j.poster_path %>" alt="" loading="lazy"><% } %>
            <span class="titre"><%= j.title %></span>
          </a>
          <span class="etoiles"><%= "★".repeat(Math.floor(j.rating / 2)) + (j.rating % 2 ? "½" : "") %></span>
        </li>
      <% } %>
    </ol>
  </section>
</div>

<% if (user && user.id === profil.id) { %>
  <form method="post" action="/logout" style="margin-top: 2rem">
    <button class="secondaire">Déconnexion</button>
  </form>

  <script>
    document.getElementById("champ-photo").addEventListener("change", async e => {
      const fichier = e.target.files[0];
      if (!fichier) return;
      const image = await createImageBitmap(fichier, { imageOrientation: "from-image" });
      const echelle = Math.min(1, 512 / Math.max(image.width, image.height));
      const canvas = document.createElement("canvas");
      canvas.width = Math.round(image.width * echelle);
      canvas.height = Math.round(image.height * echelle);
      canvas.getContext("2d").drawImage(image, 0, 0, canvas.width, canvas.height);
      const jpeg = await new Promise(ok => canvas.toBlob(ok, "image/jpeg", 0.85));
      const donnees = new FormData();
      donnees.append("avatar", jpeg, "photo.jpg");
      const reponse = await fetch("/avatar", { method: "POST", body: donnees });
      if (!reponse.ok) alert("La photo n'a pas pu être envoyée.");
      location.reload();
    });

    const cases = [...document.querySelectorAll(".favoris li[data-film]")];
    let source = null, cible = null, bouge = false, x0 = 0, y0 = 0;
    function finir() {
      cases.forEach(c => c.classList.remove("glisse", "cible"));
      source = null;
    }
    cases.forEach(li => {
      li.addEventListener("pointerdown", e => {
        if (e.target.closest(".retirer, .changer")) return;
        source = li; cible = null; bouge = false;
        x0 = e.clientX; y0 = e.clientY;
        li.setPointerCapture(e.pointerId);
      });
      li.addEventListener("pointermove", e => {
        if (source !== li) return;
        if (!bouge && Math.hypot(e.clientX - x0, e.clientY - y0) < 8) return;
        bouge = true;
        li.classList.add("glisse");
        const dessous = document.elementFromPoint(e.clientX, e.clientY);
        cible = dessous && dessous.closest(".favoris li[data-film]");
        cases.forEach(c => c.classList.toggle("cible", c === cible && c !== li));
      });
      li.addEventListener("pointerup", async () => {
        if (source !== li) return;
        const a = li, b = cible;
        finir();
        if (bouge && b && b !== a) {
          await fetch("/favoris/echanger", { method: "POST", body: new URLSearchParams({ a: a.dataset.film, b: b.dataset.film }) });
          location.reload();
        }
      });
      li.addEventListener("pointercancel", finir);
      li.addEventListener("dragstart", e => e.preventDefault());
      li.addEventListener("click", e => { if (bouge) e.preventDefault(); }, true);
    });
  </script>
<% } %>
</div>

<%- include('partials/footer') %>