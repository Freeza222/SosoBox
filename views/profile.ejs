<%- include('partials/header') %>

<h2><%= profil.username %></h2>
<% if (profil.has_avatar) { %>
  <img class="avatar-grand" src="/u/<%= encodeURIComponent(profil.username) %>/avatar" alt="">
<% } %>
<% if (user && user.id === profil.id) { %>
  <form method="post" action="/avatar" enctype="multipart/form-data">
  <label class="bouton">
    Changer ma photo
    <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp" hidden onchange="this.form.submit()">
  </label>
</form>
<% } %>
<p><%= avis.length %> film(s) noté(s)</p>
<p>
  <a href="/u/<%= encodeURIComponent(profil.username) %>/abonnes"><%= abonnes %> abonné(s)</a> ·
  <a href="/u/<%= encodeURIComponent(profil.username) %>/abonnements"><%= abonnements %> abonnement(s)</a>
</p>
<% if (user && user.id !== profil.id) { %>
  <form method="post" action="/u/<%= encodeURIComponent(profil.username) %>/follow">
    <button><%= suit ? "Ne plus suivre" : "Suivre" %></button>
  </form>
<% } %>

<h3>Films préférés</h3>
<% if (favoris.length === 0) { %><p>Aucun film favori pour l'instant.</p><% } %>
<ul class="favoris">
  <% for (const f of favoris) { %>
    <li>
      <a href="/films/<%= f.id %>">
        <% if (f.poster_path) { %><img src="https://image.tmdb.org/t/p/w342<%= f.poster_path %>" alt="<%= f.title %>"><% } %>
      </a>
    </li>
  <% } %>
</ul>

<ul class="resultats">
  <% for (const f of avis) { %>
    <li>
      <a href="/films/<%= f.id %>">
        <% if (f.poster_path) { %>
          <img src="https://image.tmdb.org/t/p/w342<%= f.poster_path %>" alt="">
        <% } %>
        <span><%= f.title %> (<%= f.year || "" %>) · <%= f.rating / 2 %>/5</span>
      </a>
    </li>
  <% } %>
</ul>

<%- include('partials/footer') %>