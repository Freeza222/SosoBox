<%- include('partials/header') %>

<div class="etroit">
<div class="banniere" <% if (banniere) { %>style="background-image: url('https://image.tmdb.org/t/p/w1280<%= banniere %>'); background-position: <%= profil.banniere_x %>% <%= profil.banniere_y %>%; background-size: <%= profil.banniere_zoom %>% auto"<% } %>></div>

<div class="profil-entete">
  <img class="avatar-grand" src="/u/<%= encodeURIComponent(profil.username) %>/avatar" alt="">
  <div class="profil-nom">
    <h2><%= profil.username %></h2>
    <% if (profil.bio) { %><p><%= profil.bio %></p><% } %>
  </div>
  <div class="chiffres">
    <a href="/u/<%= encodeURIComponent(profil.username) %>/films"><b><%= total %></b>films</a>
    <a href="/u/<%= encodeURIComponent(profil.username) %>/abonnes"><b><%= abonnes %></b>abonnés</a>
    <a href="/u/<%= encodeURIComponent(profil.username) %>/abonnements"><b><%= abonnements %></b>abonnements</a>
    <% if (compat) { %>
      <span title="Calculé sur <%= compat.n %> films notés par vous deux"><b><%= compat.score %> %</b>compatibles</span>
    <% } %>
  </div>
</div>

<% if (user && user.id === profil.id) { %>
  <div style="display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.5rem">
    <form method="post" action="/avatar" enctype="multipart/form-data">
      <label class="bouton">
        Changer ma photo
        <input type="file" id="champ-photo" accept="image/jpeg,image/png,image/webp" hidden>
      </label>
    </form>
    <button type="button" class="secondaire" onclick="document.getElementById('pseudo').showModal()">Modifier mon profil</button>
    <% if (banniere) { %>
      <button type="button" class="secondaire" id="bouton-cadrage">Recadrer la bannière</button>
    <% } %>
      <a class="bouton secondaire" href="/import">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
      Importer depuis Letterboxd
    </a>
  </div>

    <% if (banniere) { %>
    <form method="post" action="/banniere/cadrage" class="cadrage" id="cadrage" hidden>
      <input type="hidden" name="x" value="<%= profil.banniere_x %>">
      <input type="hidden" name="y" value="<%= profil.banniere_y %>">
      <span class="cadrage-aide">Fais glisser la bannière pour la placer.</span>
      <label>Zoom <input type="range" name="zoom" min="100" max="250" step="1" value="<%= profil.banniere_zoom %>"></label>
      <div class="actions">
        <button type="button" class="secondaire" onclick="location.reload()">Annuler</button>
        <button>Enregistrer</button>
      </div>
    </form>
  <% } %>

  <dialog id="pseudo">
    <form method="post" action="/pseudo">
      <h3>Modifier mon profil</h3>
      <label>Nouveau pseudo <input name="username" value="<%= profil.username %>" required minlength="3" maxlength="20"></label>
      <label>Bio <textarea name="bio" rows="3" maxlength="160" placeholder="Fan de SF et de Nolan"><%= profil.bio || "" %></textarea></label>
      <div class="actions">
        <button type="button" class="secondaire" onclick="this.closest('dialog').close()">Annuler</button>
        <button>Enregistrer</button>
      </div>
    </form>
  </dialog>
    <dialog id="recadrer" class="recadrer">
    <h3>Recadrer ma photo</h3>
    <div class="recadre-zone" id="recadre-zone">
      <img id="recadre-img" alt="Aperçu de ta photo" draggable="false">
    </div>
    <label>Zoom <input type="range" id="recadre-zoom" min="1" max="4" step="0.01" value="1"></label>
    <div class="actions">
      <button type="button" class="secondaire" id="recadre-annuler">Annuler</button>
      <button type="button" id="recadre-ok">Enregistrer</button>
    </div>
  </dialog>
<% } else if (user) { %>
  <form method="post" action="/u/<%= encodeURIComponent(profil.username) %>/follow" style="margin-bottom: 1.5rem">
    <button><%= suit ? "Ne plus suivre" : "Suivre" %></button>
  </form>
<% } %>

<div class="profil-grille">
    <div class="profil-gauche">
    <section class="top4">
      <h2 class="etiquette">Top 4
        <% if (user && user.id === profil.id) { %>
          <input type="checkbox" id="editer-top4" class="sr-only">
          <label for="editer-top4" class="editer"></label>
        <% } %>
      </h2>
      <ul class="favoris">
        <% for (let i = 0; i < 4; i++) { const f = favoris[i]; %>
          <li <% if (f && user && user.id === profil.id) { %>data-film="<%= f.id %>"<% } %>>
            <% if (f) { %>
              <a href="/films/<%= f.id %>"><img src="https://image.tmdb.org/t/p/w342<%= f.poster_path %>" alt="<%= f.title %>"></a>
              <% if (user && user.id === profil.id) { %>
                <a class="changer" href="/favoris/<%= f.id %>/affiche" aria-label="Changer l'affiche de <%= f.title %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="M21 15l-5-5L5 21"/></svg></a>
                <form method="post" action="/films/<%= f.id %>/favori">
                  <input type="hidden" name="retour" value="profil">
                  <button class="retirer" aria-label="Retirer <%= f.title %> des favoris">×</button>
                </form>
              <% } %>
            <% } else if (user && user.id === profil.id && i === favoris.length) { %>
              <a class="case-vide" href="/search?fav=1">+</a>
            <% } else { %>
              <span class="case-vide"></span>
            <% } %>
          </li>
        <% } %>
      </ul>
    </section>

    <% const moi = user && user.id === profil.id; %>
    <% if (acteurs.length > 0 || moi) { %>
      <section class="acteurs">
        <h2 class="etiquette">Acteurs préférés <% if (moi) { %><a href="/acteurs">Modifier</a><% } %></h2>
        <% if (acteurs.length === 0) { %>
          <p class="vide">Choisis tes 3 acteurs préférés.</p>
        <% } %>
        <ul class="acteurs-liste">
          <% for (const a of acteurs) { %>
            <li>
              <img src="<%= a.photo ? 'https://image.tmdb.org/t/p/w185' + a.photo : '/avatar-defaut.svg' %>" alt="">
              <b><%= a.nom %></b>
              <small><%= a.films %> films</small>
            </li>
          <% } %>
        </ul>
      </section>
    <% } %>

    <nav class="profil-liens" aria-label="Pages du profil">
      <a href="/u/<%= encodeURIComponent(profil.username) %>/a-voir">
        <span class="lien-icone"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg></span>
        <span class="lien-texte">Watchlist<small>Les films à voir</small></span>
        <span class="lien-fin">›</span>
      </a>
      <a href="/u/<%= encodeURIComponent(profil.username) %>/films">
        <span class="lien-icone"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4"/></svg></span>
        <span class="lien-texte">Tous mes films<small><%= total %> films vus</small></span>
        <span class="lien-fin">›</span>
      </a>
      <a href="/u/<%= encodeURIComponent(profil.username) %>/stats">
        <span class="lien-icone"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg></span>
        <span class="lien-texte">Statistiques<small>Tes chiffres</small></span>
        <span class="lien-fin">›</span>
      </a>
    </nav>
  </div>

  <section class="profil-journal">
    <h2 class="etiquette">Journal</h2>
    <% if (journal.length === 0) { %>
      <p>Rien pour l'instant. Remplis la date « Vu le » quand tu notes un film pour remplir le journal.</p>
    <% } %>
    <ol class="journal">
      <% let moisPrecedent = ""; %>
      <% for (const j of journal) { %>
        <% const date = new Date(j.watched_on + "T12:00:00"); %>
        <% const mois = date.toLocaleDateString("fr-FR", { month: "long", year: "numeric" }); %>
        <% if (mois !== moisPrecedent) { moisPrecedent = mois; %>
          <li class="journal-mois"><%= mois %></li>
        <% } %>
        <li class="journal-ligne">
          <span class="journal-jour"><%= String(date.getDate()).padStart(2, "0") %></span>
          <a href="/films/<%= j.id %>">
            <% if (j.poster_path) { %><img src="https://image.tmdb.org/t/p/w92<%= j.poster_path %>" alt="" loading="lazy"><% } %>
            <span class="titre"><%= j.title %></span>
            <% if (j.revu) { %>
              <svg class="journal-revu" role="img" aria-label="Revisionnage" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15.5 6.2L3 16"/><path d="M3 21v-5h5"/></svg>
            <% } %>
          </a>
          <span class="etoiles"><%= "★".repeat(Math.floor(j.rating / 2)) + (j.rating % 2 ? "½" : "") %></span>
        </li>
      <% } %>
    </ol>
  </section>
</div>

<% if (user && user.id === profil.id) { %>
  <form method="post" action="/logout" style="margin-top: 2rem">
    <button class="secondaire">Déconnexion</button>
  </form>

  <script>
    const fenetre = document.getElementById("recadrer");
    const zone = document.getElementById("recadre-zone");
    const apercu = document.getElementById("recadre-img");
    const zoom = document.getElementById("recadre-zoom");
    const boutonOk = document.getElementById("recadre-ok");
    let photo = null;           // l'image choisie (bien orientée)
    let x = 0, y = 0;           // position du coin haut-gauche de la photo dans la zone, en px
    let s = 1, base = 1;        // échelle actuelle, et échelle « zoom 1 » (la photo remplit juste le cercle)

    // la photo doit toujours couvrir tout le cercle : on bloque x et y, puis on affiche
    function placer() {
      const Z = zone.clientWidth;
      x = Math.min(0, Math.max(Z - photo.width * s, x));
      y = Math.min(0, Math.max(Z - photo.height * s, y));
      apercu.style.width = photo.width * s + "px";
      apercu.style.transform = `translate(${x}px, ${y}px)`;
    }

    document.getElementById("champ-photo").addEventListener("change", async e => {
      const fichier = e.target.files[0];
      e.target.value = "";                      // pour pouvoir rechoisir la même photo ensuite
      if (!fichier) return;
      photo = await createImageBitmap(fichier, { imageOrientation: "from-image" });
      apercu.src = URL.createObjectURL(fichier);
      boutonOk.disabled = false;
      fenetre.showModal();                      // la zone doit être affichée pour connaître sa taille
      const Z = zone.clientWidth;
      base = Z / Math.min(photo.width, photo.height);
      s = base;
      zoom.value = 1;
      x = (Z - photo.width * s) / 2;            // centrée au départ
      y = (Z - photo.height * s) / 2;
      placer();
    });

    // glisser la photo (souris ou doigt)
    let px = 0, py = 0;
    zone.addEventListener("pointerdown", e => { zone.setPointerCapture(e.pointerId); px = e.clientX; py = e.clientY; });
    zone.addEventListener("pointermove", e => {
      if (!zone.hasPointerCapture(e.pointerId)) return;
      x += e.clientX - px; y += e.clientY - py;
      px = e.clientX; py = e.clientY;
      placer();
    });

    // zoomer autour du centre du cercle
    zoom.addEventListener("input", () => {
      const c = zone.clientWidth / 2;
      const nouveau = base * zoom.value;
      x = c - (c - x) * nouveau / s;
      y = c - (c - y) * nouveau / s;
      s = nouveau;
      placer();
    });

    document.getElementById("recadre-annuler").addEventListener("click", () => fenetre.close());

    // découper ce qui est dans le cercle, en 512 x 512, et l'envoyer
    boutonOk.addEventListener("click", async () => {
      boutonOk.disabled = true;
      const Z = zone.clientWidth;
      const canvas = document.createElement("canvas");
      canvas.width = canvas.height = 512;
      canvas.getContext("2d").drawImage(photo, -x / s, -y / s, Z / s, Z / s, 0, 0, 512, 512);
      const jpeg = await new Promise(ok => canvas.toBlob(ok, "image/jpeg", 0.85));
      const donnees = new FormData();
      donnees.append("avatar", jpeg, "photo.jpg");
      const reponse = await fetch("/avatar", { method: "POST", body: donnees });
      if (!reponse.ok) alert("La photo n'a pas pu être envoyée.");
      location.reload();
    });

        // ===== Recadrer la bannière : glisser pour placer, curseur pour zoomer =====
    const cadrage = document.getElementById("cadrage");
    if (cadrage) {
      const ban = document.querySelector(".banniere");
      const champX = cadrage.elements.x, champY = cadrage.elements.y, champZ = cadrage.elements.zoom;
      const borne = v => Math.min(100, Math.max(0, v));
      let ratio = 16 / 9;                                     // largeur / hauteur de l'image (corrigé dès qu'elle est chargée)
      const img = new Image();
      img.onload = () => { ratio = img.naturalWidth / img.naturalHeight; };
      img.src = getComputedStyle(ban).backgroundImage.slice(5, -2); // url("…") → …

      function afficher() {
        ban.style.backgroundPosition = champX.value + "% " + champY.value + "%";
        ban.style.backgroundSize = champZ.value + "% auto";
      }

      document.getElementById("bouton-cadrage").addEventListener("click", () => {
        cadrage.hidden = false;
        ban.classList.add("cadrage-actif");
        ban.scrollIntoView({ behavior: "smooth", block: "center" });
      });
      champZ.addEventListener("input", afficher);

      let px = 0, py = 0;
      ban.addEventListener("pointerdown", e => {
        if (cadrage.hidden) return;                           // on ne glisse qu'en mode recadrage
        ban.setPointerCapture(e.pointerId);
        px = e.clientX; py = e.clientY;
      });
      ban.addEventListener("pointermove", e => {
        if (!ban.hasPointerCapture(e.pointerId)) return;
        const L = ban.clientWidth, H = ban.clientHeight;
        const iw = L * champZ.value / 100, ih = iw / ratio;   // taille de l'image affichée
        const dx = L - iw, dy = H - ih;                       // de combien elle dépasse (négatif)
        if (dx < 0) champX.value = borne(+champX.value + (e.clientX - px) / dx * 100);
        if (dy < 0) champY.value = borne(+champY.value + (e.clientY - py) / dy * 100);
        px = e.clientX; py = e.clientY;
        afficher();
      });
    }

    const cases = [...document.querySelectorAll(".favoris li[data-film]")];
    let source = null, cible = null, bouge = false, x0 = 0, y0 = 0;
    function finir() {
      cases.forEach(c => c.classList.remove("glisse", "cible"));
      source = null;
    }
    cases.forEach(li => {
      li.addEventListener("pointerdown", e => {
        if (e.target.closest(".retirer, .changer")) return;
        source = li; cible = null; bouge = false;
        x0 = e.clientX; y0 = e.clientY;
      });
      li.addEventListener("pointermove", e => {
        if (source !== li) return;
        if (!bouge) {
          if (Math.hypot(e.clientX - x0, e.clientY - y0) < 8) return;
          bouge = true;
          li.setPointerCapture(e.pointerId);
        }
        li.classList.add("glisse");
        const dessous = document.elementFromPoint(e.clientX, e.clientY);
        cible = dessous && dessous.closest(".favoris li[data-film]");
        cases.forEach(c => c.classList.toggle("cible", c === cible && c !== li));
      });
      li.addEventListener("pointerup", async () => {
        if (source !== li) return;
        const a = li, b = cible;
        finir();
        if (bouge && b && b !== a) {
          await fetch("/favoris/echanger", { method: "POST", body: new URLSearchParams({ a: a.dataset.film, b: b.dataset.film }) });
          location.reload();
        }
      });
      li.addEventListener("pointercancel", finir);
      li.addEventListener("dragstart", e => e.preventDefault());
      li.addEventListener("click", e => { if (bouge) e.preventDefault(); }, true);
    });
  </script>
<% } %>
</div>

<%- include('partials/footer') %>