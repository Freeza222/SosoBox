<%- include('partials/header') %>

<% if (fav) { %><p style="text-align: center">Choisis un film à ajouter à tes favoris.</p><% } %>

<form action="/search" class="recherche">
  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
  </svg>
  <input name="q" value="<%= q %>" placeholder="<%= fav ? 'Chercher un film à ajouter' : 'Un film, un ami…' %>" autocomplete="off" aria-label="Rechercher">
  <div id="suggestions"></div>
  <% if (fav) { %><input type="hidden" name="fav" value="1"><% } %>
  <% if (onglet !== "films") { %><input type="hidden" name="onglet" value="<%= onglet %>"><% } %>
  <button>Rechercher</button>
</form>

<% if (q && !fav) { %>
    <div class="onglets">
    <a href="/search?q=<%= encodeURIComponent(q) %>" class="<%= onglet === 'films' ? 'actif' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4"/></svg>Films
    </a>
    <a href="/search?q=<%= encodeURIComponent(q) %>&onglet=artistes" class="<%= onglet === 'artistes' ? 'actif' : '' %>">
      <svg class="etoile" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5-4.8-4.6 6.6-.9z"/></svg>Artistes
    </a>
    <a href="/search?q=<%= encodeURIComponent(q) %>&onglet=users" class="<%= onglet === 'users' ? 'actif' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.5 3-5.5 6.5-5.5s6.5 2 6.5 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M16.5 14.5c3 .2 5 1.8 5 4.5"/></svg>Membres
    </a>
  </div>
<% } %>

<% if (q) { %>
  <% if (onglet === "artistes") { %>
    <% if (artistes.length === 0) { %><p>Aucun acteur ni réalisateur trouvé.</p><% } %>
    <ul class="artistes">
      <% for (const a of artistes) { %>
        <li>
          <a href="/personnes/<%= a.id %>">
            <img src="https://image.tmdb.org/t/p/w185<%= a.photo %>" alt="" loading="lazy">
            <span class="artiste-texte">
              <b><%= a.nom %></b>
              <small class="metier"><%= a.metier %></small>
              <% if (a.connu) { %><span class="connu"><%= a.connu %></span><% } %>
            </span>
            <svg class="fleche" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
          </a>
        </li>
      <% } %>
    </ul>
  <% } else if (onglet === "users") { %>
    <% if (gens.length === 0) { %><p>Aucun utilisateur trouvé.</p><% } %>
    <ul class="gens">
      <% for (const g of gens) { %>
        <li>
          <a href="/u/<%= encodeURIComponent(g.username) %>">
            <img class="avatar-nav" src="/u/<%= encodeURIComponent(g.username) %>/avatar" alt="" loading="lazy">
            <%= g.username %>
          </a>
        </li>
      <% } %>
    </ul>
  <% } else { %>
    <%- include('partials/grille', { films }) %>
  <% } %>
<% } else if (genreChoisi) { %>
  <p><a class="pilule" href="/search<%= fav ? '?fav=1' : '' %>">← Tous les genres</a></p>
  <h2><%= genreChoisi.name %></h2>
  <%- include('partials/grille', { films: genreFilms }) %>
<% } else { %>
  <nav class="genres" aria-label="Parcourir par genre">
  <h2 class="etiquette">Parcourir par genre</h2>
  <% genres.forEach((g, i) => { %>
    <a class="ligne-genre ligne-genre-<%= i %><%= genreChoisi && genreChoisi.id === g.id ? ' actif' : '' %>" href="/search?genre=<%= g.id %>">
      <b><%= g.name %></b>
      <span class="pile" aria-hidden="true">
        <% for (const p of g.affiches) { %><img src="https://image.tmdb.org/t/p/w92<%= p %>" alt="" loading="lazy"><% } %>
      </span>
      <svg class="fleche" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </a>
  <% }) %>
</nav>

  <h2>Tendances de la semaine</h2>
  <div class="rangee">
    <% for (const f of tendances) { %>
      <a href="/films/<%= f.id %>" title="<%= f.title %>">
        <% if (f.poster_path) { %>
          <img src="https://image.tmdb.org/t/p/w185<%= f.poster_path %>" alt="<%= f.title %>" loading="lazy">
        <% } %>
      </a>
    <% } %>
  </div>
<% } %>

<script src="/suggestions.js" defer></script>
<script src="/glisser.js"></script>

<%- include('partials/footer') %>