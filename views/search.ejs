<%- include('partials/header') %>

<% if (fav) { %><p style="text-align: center">Choisis un film à ajouter à tes favoris.</p><% } %>

<form action="/search" class="recherche">
  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
  </svg>
  <input name="q" value="<%= q %>" placeholder="<%= fav ? 'Chercher un film à ajouter' : 'Un film, un ami…' %>" autocomplete="off" aria-label="Rechercher">
  <div id="suggestions"></div>
  <% if (fav) { %><input type="hidden" name="fav" value="1"><% } %>
  <% if (onglet === "users") { %><input type="hidden" name="onglet" value="users"><% } %>
  <button>Rechercher</button>
</form>

<% if (q && !fav) { %>
  <div class="onglets">
    <a href="/search?q=<%= encodeURIComponent(q) %>" class="<%= onglet === 'films' ? 'actif' : '' %>">Films</a>
    <a href="/search?q=<%= encodeURIComponent(q) %>&onglet=users" class="<%= onglet === 'users' ? 'actif' : '' %>">Utilisateurs</a>
  </div>
<% } %>

<% if (q) { %>
  <% if (onglet === "users") { %>
    <% if (gens.length === 0) { %><p>Aucun utilisateur trouvé.</p><% } %>
    <ul class="gens">
      <% for (const g of gens) { %>
        <li>
          <a href="/u/<%= encodeURIComponent(g.username) %>">
            <img class="avatar-nav" src="/u/<%= encodeURIComponent(g.username) %>/avatar" alt="" loading="lazy">
            <%= g.username %>
          </a>
        </li>
      <% } %>
    </ul>
  <% } else { %>
    <%- include('partials/grille', { films }) %>
  <% } %>
<% } else if (genreChoisi) { %>
  <p><a class="pilule" href="/search<%= fav ? '?fav=1' : '' %>">← Tous les genres</a></p>
  <h2><%= genreChoisi.name %></h2>
  <%- include('partials/grille', { films: genreFilms }) %>
<% } else { %>
  <nav class="genres" aria-label="Parcourir par genre">
  <h2 class="etiquette">Parcourir par genre</h2>
  <% genres.forEach((g, i) => { %>
    <a class="ligne-genre ligne-genre-<%= i %><%= genreChoisi && genreChoisi.id === g.id ? ' actif' : '' %>" href="/search?genre=<%= g.id %>">
      <b><%= g.name %></b>
      <span class="pile" aria-hidden="true">
        <% for (const p of g.affiches) { %><img src="https://image.tmdb.org/t/p/w92<%= p %>" alt="" loading="lazy"><% } %>
      </span>
      <svg class="fleche" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
    </a>
  <% }) %>
</nav>

  <h2>Tendances de la semaine</h2>
  <div class="rangee">
    <% for (const f of tendances) { %>
      <a href="/films/<%= f.id %>" title="<%= f.title %>">
        <% if (f.poster_path) { %>
          <img src="https://image.tmdb.org/t/p/w185<%= f.poster_path %>" alt="<%= f.title %>" loading="lazy">
        <% } %>
      </a>
    <% } %>
  </div>
<% } %>

<script src="/suggestions.js" defer></script>
<script src="/glisser.js"></script>

<%- include('partials/footer') %>