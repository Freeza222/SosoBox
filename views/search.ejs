<%- include('partials/header') %>

<% if (fav) { %><p>Choisis un film à ajouter à tes favoris.</p><% } %>
<% if (fav) { %><input type="hidden" name="fav" value="1"><% } %>
<form action="/search">
  <input name="q" value="<%= q %>">
  <button>Rechercher</button>
</form>

<% if (q) { %>
  <h2>Utilisateurs</h2>
  <% if (gens.length === 0) { %><p>Aucun utilisateur trouvé.</p><% } %>
  <ul>
    <% for (const g of gens) { %>
      <li><a href="/u/<%= encodeURIComponent(g.username) %>"><%= g.username %></a></li>
    <% } %>
  </ul>
  <h2>Films</h2>
<% } %>

<%- include('partials/grille', { films }) %>

<%- include('partials/footer') %>