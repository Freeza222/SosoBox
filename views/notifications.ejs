<%- include('partials/header') %>

<section class="notifs">
  <h1>Notifications</h1>

  <h2>Nouveaux abonnés</h2>
  <% if (abonnes.length === 0) { %><p>Personne ne s'est encore abonné à toi.</p><% } %>
  <ul class="fil">
    <% for (const a of abonnes) { %>
        <li class="<%= a.nouveau ? 'nouveau' : '' %> ligne-suivi">
          <span><a href="/u/<%= encodeURIComponent(a.username) %>"><%= a.username %></a> s'est abonné à toi</span>
            <% if (a.je_suis) { %>
              <span class="suivi-ok">Tu le suis</span>
            <% } else { %>
              <form method="post" action="/u/<%= encodeURIComponent(a.username) %>/follow">
              <input type="hidden" name="retour" value="/notifications">
              <button>Suivre en retour</button>
          </form>
        <% } %>
      </li>
    <% } %>
  </ul>

  <h2>Avis de tes amis</h2>
  <% if (avis.length === 0) { %><p>Aucun nouvel avis de tes abonnements.</p><% } %>
  <ul class="fil">
    <% for (const a of avis) { %>
      <li class="<%= a.nouveau ? 'nouveau' : '' %>">
        <a href="/u/<%= encodeURIComponent(a.username) %>"><%= a.username %></a> a noté
        <a href="/films/<%= a.film_id %>"><%= a.title %></a>
        <span class="etoiles"><%= "★".repeat(Math.floor(a.rating / 2)) + (a.rating % 2 ? "½" : "") %></span>
      </li>
    <% } %>
  </ul>
</section>

<%- include('partials/footer') %>