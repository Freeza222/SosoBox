<%- include('partials/header') %>

<% const real = film.credits.crew.find(p => p.job === "Director"); %>
<section class="hero-film">
  <div class="film-banniere" <% if (film.backdrop_path) { %>style="background-image: url('https://image.tmdb.org/t/p/w1280<%= film.backdrop_path %>')"<% } %>></div>
  <div class="hero-contenu">
    <% if (film.poster_path) { %>
      <img class="film-affiche" src="https://image.tmdb.org/t/p/w342<%= film.poster_path %>" alt="">
    <% } %>

    <div class="film-infos">
      <div class="genres">
        <% for (const g of film.genres) { %><span class="genre"><%= g.name %></span><% } %>
        <% if (film.runtime) { %><span class="genre"><%= Math.floor(film.runtime / 60) %> h <%= String(film.runtime % 60).padStart(2, "0") %></span><% } %>
      </div>
      <h1><%= film.title %></h1>
      <p><%= (film.release_date || "").slice(0, 4) %><% if (real) { %> · réalisé par <%= real.name %><% } %></p>

      <% if (user) { %>
        <div class="barre-film">
          <button type="button" onclick="document.getElementById('avis').showModal()"><%= monAvis ? "Modifier mon avis" : "Noter ce film" %></button>
          <% if (favori || nbFavoris < 4) { %>
            <form method="post" action="/films/<%= film.id %>/favori">
              <button class="secondaire"><%= favori ? "★ Retirer des favoris" : "☆ Ajouter aux favoris" %></button>
            </form>
          <% } else { %>
            <a class="pilule" href="/u/<%= encodeURIComponent(user.username) %>">4 favoris max · gérer mes favoris</a>
          <% } %>
          <form method="post" action="/films/<%= film.id %>/a-voir">
            <button class="secondaire"><%= aVoir ? "Déjà dans ma Watchlist" : "+ Watchlist" %></button>
          </form>
        </div>
      <% } else { %>
        <p><a href="/login">Connecte-toi</a> pour noter ce film.</p>
      <% } %>
    </div>

    <div class="film-note verre">
      <div class="note-lab">SosoBox</div>
        <div><b><%= moy ? (moy / 2).toFixed(1).replace(".", ",") : "–" %></b> / 5 · <%= avis.length %> avis</div>
                <%
        const cols = [];
        for (let k = 1; k <= 5; k++) {
          const entiers = repartition[2 * k];     // k étoiles pile
          const demis = repartition[2 * k - 1];   // k - 0,5 étoile
          cols.push({ poids: entiers + demis / 2, nb: entiers + demis });
        }
        const maxNb = Math.max(1, ...cols.map(c => c.nb));
      %>
      <div class="histo" role="img" aria-label="Répartition des notes, de 1 à 5 étoiles">
        <% cols.forEach((c, i) => { %>
          <span class="<%= i >= 3 ? 'haut' : '' %>" style="height: <%= Math.max(4, Math.round(c.poids / maxNb * 100)) %>%"></span>
        <% }) %>
      </div>
      <div class="histo-legende"><span>1</span><span>5</span></div>
      <div class="histo-legende"><span>1</span><span>5</span></div>
      <div class="note-tmdb">TMDB : <%= film.vote_count ? (film.vote_average / 2).toFixed(1).replace(".", ",") + " / 5 · " + film.vote_count.toLocaleString("fr-FR") + " votes" : "–" %></div>
    </div>
    </div>
  </div>
</section>

<% if (user) { %>
  <dialog id="avis">
    <form method="post" action="/films/<%= film.id %>/review">
      <h3><%= film.title %></h3>
      <div class="etoiles-note" role="radiogroup" aria-label="Ta note">
        <% for (let i = 10; i >= 1; i--) { %>
          <input type="radio" name="rating" id="n<%= i %>" value="<%= i %>" required <%= monAvis && monAvis.rating === i ? "checked" : "" %>>
          <label for="n<%= i %>" class="<%= i % 2 ? 'gauche' : 'droite' %>" title="<%= i / 2 %> sur 5">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.5 2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5-4.8-4.6 6.6-.9z"/></svg>
            <span class="sr-only"><%= i / 2 %> sur 5</span>
          </label>
        <% } %>
      </div>
      <label>Vu le <input name="watched_on" type="date" value="<%= monAvis ? monAvis.watched_on || "" : "" %>"></label>
      <label>Critique <textarea name="body" rows="4"><%= monAvis ? monAvis.body || "" : "" %></textarea></label>
      <div class="actions">
        <button type="button" class="secondaire" onclick="this.closest('dialog').close()">Annuler</button>
        <button>Enregistrer</button>
      </div>
    </form>
  </dialog>
<% } %>

<div class="film-bas">
  <section class="verre">
    <h2>Synopsis</h2>
    <p class="synopsis"><%= film.overview %></p>
    <% if (film.credits.cast.length > 0) { %>
      <h2>Casting</h2>
      <div class="rangee">
        <% for (const a of film.credits.cast.slice(0, 15)) { %>
          <div class="acteur">
            <% if (a.profile_path) { %>
              <img src="https://image.tmdb.org/t/p/w185<%= a.profile_path %>" alt="" loading="lazy">
            <% } else { %>
              <span class="acteur-vide"></span>
            <% } %>
            <%= a.name %>
          </div>
        <% } %>
      </div>
    <% } %>
  </section>

  <% if (amis.length > 0) { %>
    <section class="verre">
      <h2>Tes amis l'ont vu</h2>
      <ul class="amis">
        <% for (const a of amis) { %>
          <li>
            <img class="avatar-nav" src="/u/<%= encodeURIComponent(a.username) %>/avatar" alt="">
            <a href="/u/<%= encodeURIComponent(a.username) %>"><%= a.username %></a>
            <span class="etoiles"><%= "★".repeat(Math.floor(a.rating / 2)) + (a.rating % 2 ? "½" : "") %></span>
          </li>
        <% } %>
      </ul>
    </section>
  <% } %>
</div>

<h2>Avis</h2>
<% if (avis.length === 0) { %><p>Personne n'a encore noté ce film.</p><% } %>
<ul class="fil">
  <% for (const a of avis) { %>
    <li>
      <a href="/u/<%= encodeURIComponent(a.username) %>"><%= a.username %></a> : <%= a.rating / 2 %>/5
      <% if (a.watched_on) { %>(vu le <%= a.watched_on %>)<% } %>
      <% if (a.body) { %><p><%= a.body %></p><% } %>
      <% if (user && user.username === a.username) { %>
        <form method="post" action="/films/<%= film.id %>/review/delete" onsubmit="return confirm('Supprimer ton avis sur ce film ?')"><button class="petit">Supprimer</button></form>
      <% } %>
    </li>
  <% } %>
</ul>
<script src="/glisser.js"></script>

<%- include('partials/footer') %>