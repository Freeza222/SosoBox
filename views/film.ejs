<%- include('partials/header') %>

<article>
  <% if (film.poster_path) { %>
    <img src="https://image.tmdb.org/t/p/w342<%= film.poster_path %>" alt="">
  <% } %>
  <h2><%= film.title %> (<%= (film.release_date || "").slice(0, 4) %>)</h2>
  <p><%= film.genres.map(g => g.name).join(", ") %></p>
  <p><%= film.overview %></p>
  <% const real = film.credits.crew.find(p => p.job === "Director"); %>
  <% if (real) { %><p>Réalisateur : <%= real.name %></p><% } %>
  <p>Avec : <%= film.credits.cast.slice(0, 5).map(a => a.name).join(", ") %></p>
</article>

<% if (user) { %>
  <div class="barre-film">
    <button type="button" onclick="document.getElementById('avis').showModal()">Noter ce film</button>
    <form method="post" action="/films/<%= film.id %>/favori">
      <button class="secondaire"><%= favori ? "★ Retirer des favoris" : "☆ Ajouter aux favoris" %></button>
    </form>
    <form method="post" action="/films/<%= film.id %>/a-voir">
      <button class="secondaire"><%= aVoir ? "Déjà dans ma Watchlist" : "+ Watchlist" %></button>
    </form>
  </div>

<dialog id="avis">
  <form method="post" action="/films/<%= film.id %>/review">
    <h3><%= film.title %></h3>
    <div class="notes">
      <% for (let i = 1; i <= 10; i++) { %>
        <input type="radio" name="rating" id="n<%= i %>" value="<%= i %>" required>
        <label for="n<%= i %>"><%= i / 2 %></label>
      <% } %>
    </div>
    <label>Vu le <input name="watched_on" type="date"></label>
    <label>Critique <textarea name="body" rows="4"></textarea></label>
    <div class="actions">
      <button type="button" class="secondaire" onclick="this.closest('dialog').close()">Annuler</button>
      <button>Enregistrer</button>
    </div>
  </form>
</dialog>
<% } else { %>
  <p><a href="/login">Connecte-toi</a> pour noter ce film.</p>
<% } %>

<% if (moy) { %>
  <p>Note moyenne : <%= (moy / 2).toFixed(1) %>/5 (<%= avis.length %> avis)</p>
<% } %>

<ul>
  <% for (const a of avis) { %>
    <li>
      <strong><a href="/u/<%= encodeURIComponent(a.username) %>"><%= a.username %></a></strong> : <%= a.rating / 2 %>/5
      <% if (a.watched_on) { %>(vu le <%= a.watched_on %>)<% } %>
      <p><%= a.body %></p>
      <% if (user && user.username === a.username) { %>
        <form method="post" action="/films/<%= film.id %>/review/delete"><button class="petit">Supprimer</button></form>
      <% } %>
    </li>
  <% } %>
</ul>

<%- include('partials/footer') %>