<%- include('partials/header') %>

<article>
  <% if (film.poster_path) { %>
    <img src="https://image.tmdb.org/t/p/w342<%= film.poster_path %>" alt="">
  <% } %>
  <h2><%= film.title %> (<%= (film.release_date || "").slice(0, 4) %>)</h2>
  <p><%= film.genres.map(g => g.name).join(", ") %></p>
  <p><%= film.overview %></p>
  <% const real = film.credits.crew.find(p => p.job === "Director"); %>
  <% if (real) { %><p>Réalisateur : <%= real.name %></p><% } %>
  <p>Avec : <%= film.credits.cast.slice(0, 5).map(a => a.name).join(", ") %></p>
</article>

<% if (user) { %>
  <form method="post" action="/films/<%= film.id %>/review">
    <label>Note (1 à 10, chaque point = une demi-étoile) <input name="rating" type="number" min="1" max="10" required></label>
    <label>Vu le <input name="watched_on" type="date"></label>
    <label>Critique <textarea name="body"></textarea></label>
    <button>Enregistrer mon avis</button>
  </form>
<% } else { %>
  <p><a href="/login">Connecte-toi</a> pour noter ce film.</p>
<% } %>

<% if (moy) { %>
  <p>Note moyenne : <%= (moy / 2).toFixed(1) %>/5 (<%= avis.length %> avis)</p>
<% } %>

<ul>
  <% for (const a of avis) { %>
    <li>
      <strong><a href="/u/<%= encodeURIComponent(a.username) %>"><%= a.username %></a></strong> : <%= a.rating / 2 %>/5
      <% if (a.watched_on) { %>(vu le <%= a.watched_on %>)<% } %>
      <p><%= a.body %></p>
    </li>
  <% } %>
</ul>

<%- include('partials/footer') %>